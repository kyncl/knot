# Help
#  Build the image
# $ docker build -t sftp-server .
# $ docker run -d \
#   -p 2222:22 \
#   -v [PATH/TO/TESTING/PROJECTS]:/home/sftpuser/projects \
#   --name sftp \
#   sftp-server
#
#   sftp -P 2222 sftpuser@localhost
#   Password: password

FROM alpine:latest

# Install OpenSSH server
RUN apk add --no-cache openssh-server

# Create SFTP user group
RUN addgroup -g 1000 sftpusers

# Create SFTP user
RUN adduser -D -u 1000 -G sftpusers -s /bin/false sftpuser && \
    echo "sftpuser:password" | chpasswd

# Create necessary directories
RUN mkdir -p /home/sftpuser/upload && \
    mkdir -p /home/sftpuser/projects && \
    chown root:root /home/sftpuser && \
    chmod 755 /home/sftpuser && \
    chown sftpuser:sftpusers /home/sftpuser/upload && \
    chown sftpuser:sftpusers /home/sftpuser/projects 

# Generate SSH host keys
RUN ssh-keygen -A

# Configure SSHD for SFTP
RUN echo "Port 22" >> /etc/ssh/sshd_config && \
    echo "PermitRootLogin no" >> /etc/ssh/sshd_config && \
    echo "PasswordAuthentication yes" >> /etc/ssh/sshd_config && \
    echo "ChallengeResponseAuthentication no" >> /etc/ssh/sshd_config && \
    echo "UsePAM no" >> /etc/ssh/sshd_config && \
    echo "Subsystem sftp internal-sftp" >> /etc/ssh/sshd_config && \
    echo "Match Group sftpusers" >> /etc/ssh/sshd_config && \
    echo "    ChrootDirectory %h" >> /etc/ssh/sshd_config && \
    echo "    ForceCommand internal-sftp" >> /etc/ssh/sshd_config && \
    echo "    AllowTcpForwarding no" >> /etc/ssh/sshd_config && \
    echo "    X11Forwarding no" >> /etc/ssh/sshd_config

# Expose SFTP port
EXPOSE 22

# Start SSH daemon
CMD ["/usr/sbin/sshd", "-D", "-e"]
